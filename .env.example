# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# TrueForge harness
# ---------------------------------------------------------------------------
# Where the harness is listening. Default for `npx @truefoundry/trueforge`.
TRUEFORGE_BASE_URL=http://localhost:8790

# Only needed when the harness runs with OIDC login enabled. Local mode ships
# with no-auth by default, so leave this blank for development.
TRUEFORGE_TOKEN=

# Fully-qualified model name the smoke test drives, as registered in the
# harness model catalog (provider/model).
TRUEFORGE_SMOKE_MODEL=openai/gpt-5-mini

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# NOTE: provider credentials are configured *inside* the harness (via its
# settings UI or the model-provider API), not read from this file by our code.
# They are listed here so a new contributor knows what to have on hand.
#
#   OPENAI_API_KEY      — $50 of credit provided at the hackathon
#   ANTHROPIC_API_KEY   — optional second provider
#
# ---------------------------------------------------------------------------
# Connectors (later PRs)
# ---------------------------------------------------------------------------
# Bright Data MCP — product discovery. Attached as an MCP server in PR #6.
BRIGHT_DATA_API_TOKEN=

# Daytona — a hosted sandbox provider. NOT required for local development:
# standalone TrueForge ships a local sandbox fallback using the machine's own
# bash and python, and reports sandbox+skill as enabled out of the box. Only
# needed for a hosted deployment, where running agent-written code directly on
# the host is not acceptable. See docs/runbook.md step 2.
DAYTONA_API_KEY=

# Stripe TEST MODE only. Quartermaster never settles against a live retailer.
# The key must begin with sk_test_ — see packages/mcp-commerce (PR #5).
STRIPE_SECRET_KEY=
